{
  "name": "wikipro-monorepo",
  "version": "2.0.0",
  "description": "WikiPro - Plateforme d'orchestration IA pour entreprises",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yves34690/App-WikiPro.git"
  },
  "author": "Yves (CEO/Visionnaire)",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "install:all": "npm install && npm run install:frontend && npm run install:backend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:backend-only": "cd backend && npm run start:dev",
    "dev:frontend-only": "cd frontend && npm start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "cd frontend && npm test -- --watchAll=false",
    "test:backend": "cd backend && npm test",
    "test:watch": "concurrently \"npm run test:frontend:watch\" \"npm run test:backend:watch\"",
    "test:frontend:watch": "cd frontend && npm test",
    "test:backend:watch": "cd backend && npm run test:watch",
    "test:coverage": "npm run test:backend:coverage && npm run test:frontend:coverage",
    "test:backend:coverage": "cd backend && npm run test:cov",
    "test:frontend:coverage": "cd frontend && npm test -- --coverage --watchAll=false",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:frontend": "cd frontend && npm run lint || echo 'Frontend linting not configured'",
    "lint:backend": "cd backend && npm run lint",
    "lint:fix": "npm run lint:backend:fix",
    "lint:backend:fix": "cd backend && npm run lint",
    "format": "npm run format:backend",
    "format:backend": "cd backend && npm run format",
    "clean": "npm run clean:frontend && npm run clean:backend && npm run clean:root",
    "clean:frontend": "cd frontend && rm -rf build node_modules",
    "clean:backend": "cd backend && rm -rf dist node_modules",
    "clean:root": "rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:postgres": "docker-compose logs -f postgres",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "docker:build": "docker-compose build",
    "db:setup": "cd backend && npm run db:setup",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:migrate:revert": "cd backend && npm run db:migrate:revert",
    "db:generate": "cd backend && npm run db:generate",
    "db:seed": "cd backend && npm run db:seed",
    "db:reset": "cd backend && npm run db:reset",
    "db:drop": "cd backend && npm run db:drop",
    "db:status": "cd backend && npm run db:status",
    "setup": "npm run install:all && npm run docker:up && sleep 5 && npm run db:setup",
    "setup:fresh": "npm run clean && npm run setup",
    "start": "npm run dev",
    "start:prod": "concurrently \"npm run start:backend:prod\" \"npm run start:frontend:prod\"",
    "start:backend:prod": "cd backend && npm run start:prod",
    "start:frontend:prod": "cd frontend && npx serve -s build -p 3000",
    "deploy:build": "npm run build && npm run test",
    "deploy:staging": "npm run deploy:build && echo 'Deploy to staging...'",
    "deploy:production": "npm run deploy:build && echo 'Deploy to production...'",
    "health": "npm run health:backend && npm run health:frontend",
    "health:backend": "curl -f http://localhost:3001/health || echo 'Backend not running'",
    "health:frontend": "curl -f http://localhost:3000 || echo 'Frontend not running'",
    "logs": "npm run docker:logs",
    "status": "docker ps && echo '\\n=== Backend ===' && npm run health:backend && echo '\\n=== Frontend ===' && npm run health:frontend",
    "update": "npm update && cd frontend && npm update && cd ../backend && npm update"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3"
  },
  "config": {
    "frontend_port": "3000",
    "backend_port": "3001",
    "postgres_port": "5432",
    "pgadmin_port": "8080"
  },
  "keywords": [
    "wikipro",
    "ai",
    "knowledge-management",
    "orchestration",
    "react",
    "nestjs",
    "postgresql",
    "typescript"
  ]
}
