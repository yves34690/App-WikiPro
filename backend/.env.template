# WikiPro Backend - Variables d'environnement
# Copier ce fichier vers .env et modifier les valeurs selon votre environnement

# ==============================================
# CONFIGURATION APPLICATION
# ==============================================
NODE_ENV=development
PORT=3001
APP_NAME=WikiPro Backend
APP_VERSION=1.0.0

# ==============================================
# CONFIGURATION BASE DE DONNÉES
# ==============================================

# PostgreSQL Principal
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wikipro_dev
DATABASE_USERNAME=wikipro_user
DATABASE_PASSWORD=wikipro_password

# Options TypeORM
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true
DATABASE_MIGRATIONS_RUN=true

# URL complète (alternative à la config séparée)
DATABASE_URL=postgresql://wikipro_user:wikipro_password@localhost:5432/wikipro_dev

# ==============================================
# CONFIGURATION SÉCURITÉ JWT
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production-minimum-32-chars
JWT_REFRESH_EXPIRATION=7d

# Salt pour bcrypt (nombre de rounds)
BCRYPT_SALT_ROUNDS=12

# ==============================================
# CONFIGURATION CACHE REDIS
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==============================================
# CONFIGURATION CORS ET WEBSOCKET
# ==============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
WS_ORIGINS=http://localhost:3000,http://localhost:3002

# ==============================================
# CONFIGURATION PROVIDERS IA
# ==============================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google (Gemini)
GOOGLE_API_KEY=your-google-ai-api-key-here

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here

# ==============================================
# CONFIGURATION MONITORING
# ==============================================

# Télémétrie
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT=http://localhost:4318/v1/traces

# Logging
LOG_LEVEL=info
LOG_FILE=logs/wikipro.log

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ==============================================
# CONFIGURATION DÉVELOPPEMENT
# ==============================================

# Debug
DEBUG=true
DEBUG_SQL=true

# Hot reload
WATCH_MODE=true

# Test database (optionnel)
TEST_DATABASE_NAME=wikipro_test
TEST_DATABASE_URL=postgresql://wikipro_user:wikipro_password@localhost:5432/wikipro_test