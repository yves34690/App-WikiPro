# WikiPro Backend - Exemple de configuration pour développement
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://wikipro_user:wikipro_password@localhost:5432/wikipro_dev
DATABASE_ENABLED=false
JWT_SECRET=dev-jwt-secret-key-change-in-production-32-chars-minimum
JWT_REFRESH_SECRET=dev-refresh-jwt-secret-change-in-production-32-chars-minimum
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ===== CONFIGURATION IA GATEWAY =====

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Anthropic Configuration  
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TEMPERATURE=0.7

# Google Gemini Configuration
GOOGLE_AI_API_KEY=AIyour-google-ai-api-key-here
GEMINI_MODEL=gemini-pro
GEMINI_MAX_TOKENS=4000
GEMINI_TEMPERATURE=0.7

# AI Gateway Settings
AI_MODE=development
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_ENABLED=true
AI_TIMEOUT_GLOBAL=15000
AI_RETRY_MAX=3
AI_RETRY_DELAY=1000

# Quotas & Limits (USD)
AI_TENANT_MONTHLY_LIMIT=50.00
AI_GLOBAL_DAILY_LIMIT=500.00
AI_ALERT_THRESHOLD_1=80
AI_ALERT_THRESHOLD_2=95

# Health Check Configuration
AI_HEALTH_CHECK_INTERVAL=300000
AI_HEALTH_CHECK_TIMEOUT=5000
AI_HEALTH_CHECK_ENABLED=true

# Logging & Monitoring
AI_LOG_LEVEL=info
AI_METRICS_ENABLED=true
AI_DEBUG_MODE=false