# ==============================================================================
# WIKIPRO MONOREPO - GITIGNORE OPTIMISÉ
# ==============================================================================

# ==============================================================================
# NŒUDS ET DÉPENDANCES
# ==============================================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Package managers
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ==============================================================================
# ENVIRONNEMENTS ET CONFIGURATION SENSIBLE
# ==============================================================================

# Variables d'environnement
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Configuration locale
.envrc
.env.*
!.env.template
!.env.example

# ==============================================================================
# BUILDS ET DISTRIBUTIONS
# ==============================================================================

# Frontend builds
frontend/build/
frontend/dist/
frontend/.next/
frontend/out/

# Backend builds
backend/dist/
backend/build/

# Storybook build outputs
.out
.storybook-out
storybook-static

# ==============================================================================
# BASES DE DONNÉES ET CACHES
# ==============================================================================

# Base de données locale
*.db
*.sqlite
*.sqlite3

# Redis dumps
dump.rdb

# Cache files
.cache/
.parcel-cache/
.next/cache/

# ==============================================================================
# LOGS ET MONITORING
# ==============================================================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# ==============================================================================
# TESTS ET COVERAGE
# ==============================================================================

# Test coverage
coverage/
.coverage
*.lcov
.nyc_output

# Jest cache
.jest/

# Test results
test-results/
junit.xml

# ==============================================================================
# ÉDITEURS ET IDEs
# ==============================================================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# ==============================================================================
# SYSTÈMES D'EXPLOITATION
# ==============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.tmp
*.temp
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ==============================================================================
# DOCKER ET CONTAINERS
# ==============================================================================

# Docker
.dockerignore
Dockerfile.local

# Docker Compose override
docker-compose.override.yml
docker-compose.local.yml

# ==============================================================================
# SÉCURITÉ ET SECRETS
# ==============================================================================

# Clés et certificats
*.key
*.pem
*.p12
*.crt
*.cer
*.pfx

# Fichiers de secrets
secrets.json
.secrets
credentials.json

# ==============================================================================
# MONOREPO SPÉCIFIQUE
# ==============================================================================

# Fichiers de workspace
.workspace

# Scripts de développement local
scripts/local/
scripts/dev-local/

# ==============================================================================
# WIKIPRO SPÉCIFIQUE
# ==============================================================================

# Uploads utilisateurs
uploads/
user-files/

# Fichiers de démonstration temporaires
demo-data/
temp-screenshots/

# Documentation générée automatiquement
docs/api/generated/

# ==============================================================================
# EXCEPTIONS (FICHIERS À INCLURE)
# ==============================================================================

# Garder certains fichiers importants
!.gitkeep
!.gitignore
!.env.template
!.env.example
!README*.md
!docs/
!public/
.env.*.local
